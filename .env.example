# Required. Paste the key after the equals sign; do not quote it.
GEMINI_API_KEY=

# Gemini page transcription settings.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=HIGH
GEMINI_MEDIA_RESOLUTION=HIGH
GEMINI_MAX_OUTPUT_TOKENS=65536
GEMINI_MAX_RETRIES=5
GEMINI_REQUESTS_PER_DAY=18
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=15
GEMINI_PAUSE_ON_RATE_LIMIT=true
GEMINI_RATE_LIMIT_RETRY_SECONDS=300
MAX_CONSECUTIVE_PAGE_FAILURES=5

# PDF rendering and watcher settings.
RENDER_DPI=240
POLL_SECONDS=5
FILE_STABLE_SECONDS=8
MOVE_COMPLETED_PDFS=true
KEEP_PAGE_IMAGES=true
PAGE_IMAGE_FORMAT=JPEG
PAGE_JPEG_QUALITY=90
# Optional JPEG overlays for pages whose native structure needs visual review.
NATIVE_DEBUG_OVERLAYS=false
# Opt-in: use deterministic native Markdown without an LLM only when all
# native quality/layout gates pass and needs_visual_parser is false.
NATIVE_PAGE_ROUTER_ENABLED=false

# Local retrieval chunks for Gemini File Search or another API consumer.
CHUNK_TARGET_TOKENS=750
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=120

# Static SQLite corpus packing. Packing is a separate command from the watcher.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=32
